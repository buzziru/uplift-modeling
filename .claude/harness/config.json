{
  "check": [
    "uv run ruff check .",
    "uv run ruff format --check .",
    {
      "run": "uv run pyright",
      "paths": [
        "src/",
        "scripts/",
        "tests/",
        "pyproject.toml",
        "uv.lock"
      ]
    },
    {
      "run": "uv run pytest",
      "paths": [
        "src/",
        "tests/",
        "scripts/",
        "experiments/",
        ".claude/harness/",
        ".github/scripts/",
        "pyproject.toml",
        "uv.lock"
      ]
    },
    "uv run marimo check analyses",
    "uv run python .claude/harness/check_docs.py"
  ],
  "axes": {
    "독자": [
      "채용 담당자"
    ],
    "산출물": [
      "코드",
      "모델",
      "보고서",
      "사이트"
    ],
    "주제": [
      "uplift"
    ]
  },
  "context": "plugin",
  "library": []
}
